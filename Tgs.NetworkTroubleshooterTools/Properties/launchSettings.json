{
  "profiles": {
    "http": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "OTEL_SERVICE_NAME": "Network-Troubleshooting-Tools(local)",
        "RELEASE_NAMESPACE": "dev",
        "POD_IP": "127.0.0.1"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:5243"
    },
    "https": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "OTEL_SERVICE_NAME": "Network-Troubleshooting-Tools(local)",
        "RELEASE_NAMESPACE": "dev",
        "POD_IP": "127.0.0.1"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:7211;http://localhost:5243"
    },
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/swagger",
      "environmentVariables": {
        "ASPNETCORE_URLS": "https://+:443;http://+:80"
      },
      "publishAllPorts": true,
      "useSSL": true
    }
  },
  "$schema": "http://json.schemastore.org/launchsettings.json"
}